# Runtime settings for the FastAPI portal. Configure real values in Render's
# environment settings; never copy production secrets into this file.
APP_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
CSRF_SECRET=replace-with-a-long-random-secret
DOCUMENT_ENCRYPTION_KEY=replace-with-a-valid-Fernet-key
MASTER_ADMIN_MOBILE=replace-with-approved-admin-mobile
# On production startup, a token of at least 32 characters enables initial
# master-account provisioning. Complete setup with this token and remove it.
# Existing accounts and their 2FA are never reset by startup.
RM_MASTER_BOOTSTRAP_TOKEN=

# WARNING: true resets master 2FA and backup codes at every process startup.
# Password-only re-enrollment is possible after each reset. Keep false unless
# this weaker security behavior is explicitly required.
MASTER_2FA_RESET_ON_STARTUP=false

# Optional neural assistant voice. Leave blank to use browser speech fallback.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_BENGALI_VOICE_ID=

# SECRET_KEY and OPENAI_API_KEY are not consumed by the current FastAPI app.
# The assistant uses its built-in engine; CSRF_SECRET signs session/speech tokens.
# Render supplies PORT automatically.
