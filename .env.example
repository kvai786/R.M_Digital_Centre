DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
APP_ENV=production
MASTER_ADMIN_MOBILE=0000000000
RM_MASTER_BOOTSTRAP_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
UPLOAD_STORAGE_DIR=/data/private-documents
DOCUMENT_ENCRYPTION_KEY=generate-a-fernet-key-and-store-it-as-a-secret

# PostgreSQL connection pool defaults; tune to database connection limits.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
