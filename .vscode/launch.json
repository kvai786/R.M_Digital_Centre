{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Run R.M Digital Centre portal",
            "type": "debugpy",
            "request": "launch",
            "module": "http.server",
            "args": [
                "8000",
                "--bind",
                "127.0.0.1"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
